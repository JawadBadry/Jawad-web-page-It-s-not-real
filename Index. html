<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>معرض أعمال جواد المطور</title>
  <style>
    /* 1️⃣ تهيئة التصميم والألوان الأساسية (Modern Dark Theme) */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      scroll-behavior: smooth;
    }

    body {
      background: radial-gradient(circle at center, #2c1a13 0%, #120a07 100%);
      color: #ffffff;
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* 2️⃣ الهيدر الاحترافي (بدون النقاط وبلمسة زجاجية) */
    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 20px 8%;
      background: rgba(33, 20, 14, 0.6);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid rgba(223, 177, 55, 0.2);
      position: sticky;
      top: 0;
      z-index: 1000;
    }

    .logo-area {
      display: flex;
      align-items: center;
      gap: 15px;
    }

    header img {
      border-radius: 50%;
      border: 2px solid #dfb137;
      object-fit: cover;
      box-shadow: 0 0 15px rgba(223, 177, 55, 0.3);
    }

    .nav-links {
      display: flex;
      list-style: none; /* إخفاء النقاط تماماً */
      gap: 30px;
    }

    .nav-links a {
      text-decoration: none;
      color: #ffffff;
      font-weight: 600;
      font-size: 16px;
      transition: all 0.3s ease;
      position: relative;
    }

    .nav-links a:hover {
      color: #dfb137;
    }

    /* تأثير الخط الذهبي تحت الروابط عند التمرير */
    .nav-links a::after {
      content: '';
      position: absolute;
      width: 0;
      height: 2px;
      bottom: -5px;
      left: 0;
      background-color: #dfb137;
      transition: width 0.3s ease;
    }

    .nav-links a:hover::after {
      width: 100%;
    }

    /* 3️⃣ حاوية المحتوى الرئيسية */
    .main-container {
      max-width: 1200px;
      margin: 50px auto;
      padding: 0 40px;
    }

    .page-title {
      text-align: center;
      font-size: 42px;
      color: #dfb137;
      margin-bottom: 10px;
      letter-spacing: 1px;
      text-shadow: 0 2px 10px rgba(223, 177, 55, 0.2);
    }

    .divider-hr {
      border: none;
      height: 1px;
      background: linear-gradient(to right, transparent, #dfb137, transparent);
      margin-bottom: 60px;
    }

    /* 4️⃣ قسم بطاقة العمل المطور (قسم الـ Flex المتقدم) */
    .work-section {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 60px;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(223, 177, 55, 0.1);
      padding: 40px;
      border-radius: 20px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      transition: transform 0.4s ease, border-color 0.4s ease;
    }

    /* تأثير الـ 3D عند مرور الماوس على الكرت كاملاً */
    .work-section:hover {
      transform: translateY(-5px);
      border-color: rgba(223, 177, 55, 0.4);
    }

    .image-wrapper {
      flex: 1;
      display: flex;
      justify-content: center;
    }

    .project-img {
      border-radius: 15px;
      border: 2px solid #dfb137;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.7);
      transition: transform 0.5s ease;
    }

    .work-section:hover .project-img {
      transform: scale(1.03) rotate(-1deg);
    }

    .content-wrapper {
      flex: 1.3;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .project-name {
      font-size: 28px;
      color: #dfb137;
    }

    .project-description {
      font-size: 17px;
      line-height: 1.8;
      color: #dddddd;
    }

    /* 5️⃣ أزرار التحميل والنسخ الاحترافية التفاعلية */
    .buttons-group {
      display: flex;
      flex-wrap: wrap;
      gap: 15px;
      margin-top: 10px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 12px 25px;
      font-size: 15px;
      font-weight: bold;
      border-radius: 8px;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.3s ease;
    }

    /* زر الموقع */
    .btn-primary {
      background: transparent;
      color: #dfb137;
      border: 2px solid #dfb137;
    }

    .btn-primary:hover {
      background: #dfb137;
      color: #120a07;
      box-shadow: 0 5px 15px rgba(223, 177, 55, 0.4);
    }

    /* زر تحميل الـ APK */
    .btn-secondary {
      background: #dfb137;
      color: #120a07;
      border: 2px solid #dfb137;
    }

    .btn-secondary:hover {
      background: #c3982e;
      border-color: #c3982e;
      transform: translateY(-2px);
      box-shadow: 0 5px 15px rgba(223, 177, 55, 0.3);
    }

    /* زر نسخ الإيميل الصامت والمطور */
    .btn-copy {
      background: #33221a;
      color: #ffffff;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .btn-copy:hover {
      background: #44332a;
      border-color: #dfb137;
    }

    /* 6️⃣ التصميم المتجاوب بالكامل مع الجوال (Responsive) */
    @media (max-width: 768px) {
      header {
        flex-direction: column;
        gap: 20px;
        padding: 20px;
      }

      .nav-links {
        gap: 20px;
      }

      .work-section {
        flex-direction: column;
        padding: 25px;
        text-align: center;
      }

      .buttons-group {
        justify-content: center;
      }

      .page-title {
        font-size: 32px;
      }
    }
  </style>
</head>
<body>

  <header>
    <div class="logo-area">
      <img src="WhatsApp Image 2024-11-04 at 19.09.30_e5fee057.jpg" alt="جواد" width="65" height="65">
    </div>
    <nav>
      <ul class="nav-links">
        <li><a href="اهتماماتي.html">اهتماماتي</a></li>
        <li><a href="index.html">الرئيسية</a></li>
        <li><a href="التواصل.html">التواصل</a></li>
      </ul>
    </nav>
  </header>

  <main class="main-container">
    
    <h1 class="page-title">أعمالي البرمجية</h1>
    <hr class="divider-hr">

    <section class="work-section">
      
      <div class="image-wrapper">
        <img src="clicker game.png" alt="Clicker Game" class="project-img" width="300" height="300">
      </div>

      <div class="content-wrapper">
        <h2 class="project-name">لعبة Clicker Game</h2>
        <p class="project-description">
          عبارة عن تطبيق وموقع متكامل يتيح للمستخدمين النقر لجمع النقاط وتحقيق الإنجازات المتتالية. المشروع حالياً قيد التطوير المكثف، وأعمل على إضافة تحديثات مستمرة وميزات تنافسية ممتعة لجعل تجربة اللعب فريدة ومثيرة.
        </p>
        
        <div class="buttons-group">
          <a href="https://jawadbadry.github.io/clicker-game/" class="btn btn-primary" target="_blank">تجربته كموقع</a>
          
          <a href="clickergame.apk" download class="btn btn-secondary">تحميله كتطبيق (APK)</a>
          
          <button class="btn btn-copy" id="copyBtn" onclick="navigator.clipboard.writeText('Jawadbadry8@gmail.com'); this.innerText='تم نسخ الإيميل! ✅'">
            نسخ إيميل المطور
          </button>
        </div>
      </div>

    </section>

  </main>

</body>
</html>
